{
  "manifest_version": 3,
  "name": "TerpWhisper",
  "version": "1.0.0",
  "description": "AI-powered professor review summaries",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/star.png",
      "48": "icons/star.png",
      "128": "icons/star.png"
    }
  },
  "icons": {
    "16": "icons/star.png",
    "48": "icons/star.png",
    "128": "icons/star.png"
  },
  "permissions": ["downloads"],
  "host_permissions": [
    "https://planetterp.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ]
}